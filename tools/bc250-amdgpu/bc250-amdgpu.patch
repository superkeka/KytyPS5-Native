+		amdgpu_gmc_flush_gpu_tlb(adev, pdd->qpd.vmid, AMDGPU_GFXHUB(0),
+					 TLB_FLUSH_LEGACY);
+		return;
+	}
 	amdgpu_vm_flush_compute_tlb(adev, vm, TLB_FLUSH_HEAVYWEIGHT,
 				    pdd->dev->xcc_mask);
 }
